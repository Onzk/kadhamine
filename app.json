{
  "expo": {
    "name": "Kadhamine",
    "slug": "talenttchad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tchadtalent",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F0EE",
    "ios": {
      "icon": "./assets/expo.icon",
      "backgroundColor": "#F3F0EE"
    },
    "android": {
      "package": "com.tchadtalent.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "barStyle": "dark"
        }
      ],
      "./plugins/withTransparentNavBar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kadhamine utilise votre position pour trouver des talents proches."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kadhamine utilise la caméra pour votre portfolio et la vérification d'identité."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kadhamine accède à vos photos pour le portfolio.",
          "cameraPermission": "Kadhamine utilise la caméra pour le portfolio."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Kadhamine utilise le micro pour les messages vocaux."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kadhamine utilise le micro pour les messages vocaux."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.swmansion.** { *; }\n-dontwarn com.facebook.react.**\n-dontwarn com.facebook.hermes.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark"
      },
      "eas": {
        "projectId": "fbcc4c0a-5a8c-4d13-961c-b718a5210c82"
      }
    },
    "owner": "justinkdss"
  }
}
