# Convex (client)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Convex backend — générer avec: npm run auth:setup
# JWT_PRIVATE_KEY et JWKS sont définis via `npx convex env set` (pas dans ce fichier)

# FedaPay (https://fedapay.com)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENV=sandbox
FEDAPAY_CALLBACK_URL=

EAS_SKIP_AUTO_FINGERPRINT=1
